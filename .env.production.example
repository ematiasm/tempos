# tempos — Production environment template (DO VPS + Traefik)
# Copy to the server as `.env` (or `.env.production`) and fill in every value.
# NEVER commit real values.

# Public domain for the app. The frontend is served at `dashboard.<DOMAIN>`
# and the backend API at `api.<DOMAIN>` (see the Traefik routers in compose.yml).
DOMAIN=yourdomain.com

# Compose project name (also used in Traefik router/service names).
STACK_NAME=tempos

ENVIRONMENT=production

# Backend
SECRET_KEY=changeme-a-long-random-secret-key-at-least-32-bytes
BACKEND_CORS_ORIGINS=https://dashboard.yourdomain.com
FRONTEND_HOST=https://dashboard.yourdomain.com

# First superuser (seeded on first startup only)
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=changeme-a-strong-password

# PostgreSQL (internal network only; the db service is not exposed)
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_DB=tempos
POSTGRES_USER=tempos
POSTGRES_PASSWORD=changeme-a-strong-db-password

# Docker images (template convention; `latest` tag is built locally by
# `docker compose build` on the server)
DOCKER_IMAGE_BACKEND=tempos-backend
DOCKER_IMAGE_FRONTEND=tempos-frontend
TAG=latest

# SMTP (optional — password recovery emails). Leave empty to disable.
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
SMTP_PORT=587
SMTP_SSL=false
SMTP_TLS=true
EMAILS_FROM_EMAIL=no-reply@yourdomain.com

# Sentry (optional)
SENTRY_DSN=

# The frontend build needs the public API URL as a build arg (frontend/Dockerfile).
# compose.yml already passes VITE_API_URL=https://api.${DOMAIN} as an arg.
